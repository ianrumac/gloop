{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    // Resolve workspace packages (@hypen-space/gloop-loop) to their source
    // via the "bun" export condition, so typechecking needs no build step.
    "customConditions": ["bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Type roots
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  // The CLI only.  tests/ is a deliberately buggy fixture app and lander/ a
  // separate site, each with its own deps; packages/* typecheck themselves.
  "include": ["bin", "src", "components", "types", "*.ts"],
  "exclude": ["node_modules", "tests", "lander", "packages", ".gloop"]
}
